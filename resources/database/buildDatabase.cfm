<!---
  Apache Derby embedded: schema + seed data for ColdFusion Training (local CommandBox / dev).
  Theme: curriculum / workshop - fresh seed, not copied from legacy exercises.
  Note: Derby does not support CREATE TABLE IF NOT EXISTS; createTableIfMissing catches existing-table errors.
  Verified: JDBC datasource via Application.cfc (Adobe User Guide); Apache Derby Embedded SQL.
--->
<cfsetting requestTimeout="120">
<cfscript>
	void function createTableIfMissing(required string sql, required struct opts) {
		try {
			queryExecute(arguments.sql, {}, arguments.opts);
		} catch (any e) {
			// Derby: X0Y32 table already exists; also tolerate message text variants.
			var msg = toString(e.message & " " & e.detail);
			if (
				!findNoCase("already exists", msg)
				&& !findNoCase("X0Y32", msg)
				&& !findNoCase("Table/View", msg)
			) {
				rethrow;
			}
		}
	}

	void function createTrainingDatabase() {
		var opts = { datasource: "CFTrainingDSN" };
		var rowCount = 0;

		// Idempotent: safe if build runs more than once (e.g. race or prior failed run).
		createTableIfMissing("CREATE TABLE employees ( employeeId INT NOT NULL GENERATED ALWAYS AS IDENTITY (START WITH 1, INCREMENT BY 1) PRIMARY KEY, firstName VARCHAR(60), lastName VARCHAR(60), hireDate DATE )", opts);
		createTableIfMissing("CREATE TABLE users ( userId INT NOT NULL GENERATED BY DEFAULT AS IDENTITY (START WITH 1, INCREMENT BY 1) PRIMARY KEY, userName VARCHAR(120) NOT NULL, email VARCHAR(255) NOT NULL, active INTEGER NOT NULL DEFAULT 1, status VARCHAR(30) NOT NULL DEFAULT 'active', createdDate TIMESTAMP DEFAULT CURRENT_TIMESTAMP )", opts);
		createTableIfMissing("CREATE TABLE products ( productId INT NOT NULL GENERATED ALWAYS AS IDENTITY PRIMARY KEY, productName VARCHAR(200) NOT NULL, unitPrice DECIMAL(10,2) NOT NULL, categoryId INT NOT NULL, active SMALLINT NOT NULL DEFAULT 1, discontinued SMALLINT, status VARCHAR(30) DEFAULT 'active' )", opts);
		createTableIfMissing("CREATE TABLE orders ( orderId INT NOT NULL GENERATED BY DEFAULT AS IDENTITY (START WITH 100, INCREMENT BY 1) PRIMARY KEY, customerId INT NOT NULL, orderDate DATE, status VARCHAR(30) NOT NULL )", opts);
		createTableIfMissing("CREATE TABLE articles ( id INT NOT NULL GENERATED ALWAYS AS IDENTITY PRIMARY KEY, title VARCHAR(500) NOT NULL, created TIMESTAMP DEFAULT CURRENT_TIMESTAMP )", opts);
		createTableIfMissing("CREATE TABLE contacts ( id INT NOT NULL GENERATED ALWAYS AS IDENTITY PRIMARY KEY, name VARCHAR(200) NOT NULL, email VARCHAR(255) NOT NULL, created TIMESTAMP DEFAULT CURRENT_TIMESTAMP )", opts);
		createTableIfMissing("CREATE TABLE bigTable ( id INT NOT NULL GENERATED ALWAYS AS IDENTITY PRIMARY KEY, payload VARCHAR(120) )", opts);

		try {
			rowCount = queryExecute("SELECT COUNT(*) AS cnt FROM employees", {}, opts).cnt[1];
		} catch (any e) {
			rowCount = 0;
		}
		if (rowCount > 0) {
			return;
		}

		queryExecute("INSERT INTO employees (firstName, lastName, hireDate) VALUES ('Riley', 'Ortiz', DATE('2024-01-15'))", {}, opts);
		queryExecute("INSERT INTO employees (firstName, lastName, hireDate) VALUES ('Jordan', 'Park', DATE('2023-09-01'))", {}, opts);
		queryExecute("INSERT INTO employees (firstName, lastName, hireDate) VALUES ('Sam', 'Okonkwo', DATE('2022-04-20'))", {}, opts);

		queryExecute("INSERT INTO users (userName, email, active, status) VALUES ('alopez', 'a.lopez@training.local', 1, 'active')", {}, opts);
		queryExecute("INSERT INTO users (userName, email, active, status) VALUES ('bmartinez', 'b.martinez@training.local', 1, 'active')", {}, opts);
		queryExecute("INSERT INTO users (userName, email, active, status) VALUES ('ckim', 'c.kim@training.local', 1, 'inactive')", {}, opts);
		queryExecute("INSERT INTO users (userName, email, active, status) VALUES ('dnwosu', 'd.nwosu@training.local', 0, 'inactive')", {}, opts);
		queryExecute("INSERT INTO users (userName, email, active, status) VALUES ('ereed', 'e.reed@training.local', 1, 'active')", {}, opts);
		queryExecute("INSERT INTO users (userName, email, active, status) VALUES ('fadmin', 'admin@training.local', 1, 'active')", {}, opts);

		queryExecute("INSERT INTO products (productName, unitPrice, categoryId, active, discontinued, status) VALUES ('Module 0 - Orientation', 0.00, 1, 1, 0, 'active')", {}, opts);
		queryExecute("INSERT INTO products (productName, unitPrice, categoryId, active, discontinued, status) VALUES ('Module 3 - Data access', 0.00, 1, 1, 0, 'active')", {}, opts);
		queryExecute("INSERT INTO products (productName, unitPrice, categoryId, active, discontinued, status) VALUES ('Module 6 - Security', 0.00, 2, 1, 0, 'draft')", {}, opts);
		queryExecute("INSERT INTO products (productName, unitPrice, categoryId, active, discontinued, status) VALUES ('Module 9 - APIs and integration', 0.00, 2, 1, NULL, 'active')", {}, opts);
		queryExecute("INSERT INTO products (productName, unitPrice, categoryId, active, discontinued, status) VALUES ('Module 12 - Capstone lab', 0.00, 3, 1, 0, 'active')", {}, opts);

		queryExecute("INSERT INTO orders (customerId, orderDate, status) VALUES (1, DATE('2025-01-10'), 'pending')", {}, opts);
		queryExecute("INSERT INTO orders (customerId, orderDate, status) VALUES (2, DATE('2025-01-11'), 'shipped')", {}, opts);
		queryExecute("INSERT INTO orders (customerId, orderDate, status) VALUES (1, DATE('2025-02-01'), 'delivered')", {}, opts);
		queryExecute("INSERT INTO orders (customerId, orderDate, status) VALUES (5, DATE('2025-02-15'), 'pending')", {}, opts);
		queryExecute("INSERT INTO orders (customerId, orderDate, status) VALUES (6, DATE('2025-03-01'), 'shipped')", {}, opts);

		queryExecute("INSERT INTO articles (title) VALUES ('Why use queryExecute with parameters?')", {}, opts);
		queryExecute("INSERT INTO articles (title) VALUES ('CFML tag vs script: pick one style per file')", {}, opts);
		queryExecute("INSERT INTO articles (title) VALUES ('Session basics for training labs')", {}, opts);
		queryExecute("INSERT INTO articles (title) VALUES ('REST services next: map verbs to resources')", {}, opts);

		queryExecute("INSERT INTO contacts (name, email) VALUES ('Morgan Singh', 'morgan.singh@example.org')", {}, opts);
		queryExecute("INSERT INTO contacts (name, email) VALUES ('Jamie Liu', 'jamie.liu@example.org')", {}, opts);
		queryExecute("INSERT INTO contacts (name, email) VALUES ('Casey Rivera', 'casey.rivera@example.org')", {}, opts);
		queryExecute("INSERT INTO contacts (name, email) VALUES ('Taylor Brooks', 'taylor.brooks@example.org')", {}, opts);

		for (i = 1; i <= 300; i++) {
			queryExecute("INSERT INTO bigTable (payload) VALUES (?)", ["row-" & i], opts);
		}
	}

	createTrainingDatabase();
</cfscript>
